{
  "name": "agent-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @agent-world/server dev\" \"pnpm --filter @agent-world/web dev\"",
    "start": "pnpm --filter @agent-world/web build && pnpm --filter @agent-world/server start",
    "smoke": "node scripts/smoke.mjs",
    "wallet:setup": "node scripts/wallet-setup.mjs",
    "jev:probe": "node scripts/jev-probe.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/lib/wallet-setup.test.mjs scripts/lib/jev-probe.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
