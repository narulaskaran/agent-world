{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @agent-world/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "0 0 * * *"
    }
  ]
}
