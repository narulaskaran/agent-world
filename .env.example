# Use deterministic local agents until the wallet is ready.
AGENT_WORLD_LIVE_MPP=false
MPPX_BIN=mppx
MPPX_ACCOUNT=agent-world
AGENT_WORLD_DATABASE=./data/agent-world.db
AGENT_WORLD_SERVER_PORT=4310
AGENT_WORLD_WEB_ORIGIN=http://localhost:4311

# Shorter clocks are useful only for local automated tests.
AGENT_WORLD_DECISION_SCALE=1
AGENT_WORLD_REACTION_COOLDOWN_MS=10000
AGENT_WORLD_GLOBAL_DAILY_BUDGET_MICROS=2000000

# Vercel + Neon production/preview configuration.
# The Neon Vercel integration supplies a pooled DATABASE_URL per environment.
# Do not commit real values; set these in Vercel Project Settings or with the
# Vercel CLI. The local SQLite adapter above remains the deterministic default.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://example.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Neon Auth's Vite client URL is safe to expose in the browser bundle.
VITE_NEON_AUTH_URL=https://example.neon.tech/neondb/auth

# Vercel Cron sends: Authorization: Bearer $CRON_SECRET.
# Keep this server-only and configure the same value in the Vercel project.
CRON_SECRET=replace-with-a-random-secret

# The Vite client uses same-origin API calls when unset in production. Set this
# only when the API is deployed at a separate origin.
VITE_API_URL=

# Reserved for later milestones; leave unset while deterministic mode is the
# production acceptance path. These are server-side secrets unless noted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
