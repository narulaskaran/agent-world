# Loopback bind. Admin routes are unauthenticated, so do not expose this port.
AGENT_WORLD_HOST=127.0.0.1
# Local HTTP/WebSocket port for the world server.
AGENT_WORLD_SERVER_PORT=4310
# SQLite file used by the local world (created automatically).
AGENT_WORLD_DATABASE=./data/agent-world.db
# Vite dev origin allowed by CORS (production is same-origin and ignores this).
AGENT_WORLD_WEB_ORIGIN=http://localhost:4311
# Optional Vite-only API base; leave empty so production uses same-origin.
VITE_API_URL=
# World speed multiplier (0.1–60). Higher values spend faster when keys are set.
AGENT_WORLD_DECISION_SCALE=1
# Minimum delay between reactions for one character, in milliseconds.
AGENT_WORLD_REACTION_COOLDOWN_MS=10000
# Server-wide daily spend cap in millionths of a dollar (2000000 = $2).
AGENT_WORLD_GLOBAL_DAILY_BUDGET_MICROS=2000000
# The only inference key: OpenRouter chat plus JEV decisions. Leave empty for free deterministic mode.
OPENROUTER_API_KEY=
# Set to false to skip JEV and use OpenRouter LLM decisions (or deterministic if no key).
AGENT_WORLD_JEV_DECISIONS=
# OpenRouter Decisions model id (alpha). Default is typesafe/jev-1.13.
AGENT_WORLD_JEV_MODEL=typesafe/jev-1.13
# Pay-as-you-go paid tools via local mppx. Off until you run pnpm wallet:setup.
AGENT_WORLD_LIVE_MPP=false
# Optional path to the mppx binary; pnpm install provides one.
MPPX_BIN=
# Local mppx account name stored in the OS keychain.
MPPX_ACCOUNT=agent-world
# Fastify log level (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info
